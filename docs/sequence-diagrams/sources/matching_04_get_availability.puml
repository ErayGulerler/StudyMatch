@startuml
hide footbox
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam dpi 160
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam ParticipantPadding 15
skinparam BoxPadding 8
skinparam sequence {
 ArrowColor #139D90
 LifeLineBorderColor #A5BFC2
 ParticipantBackgroundColor #183840
 ParticipantBorderColor #183840
 ParticipantFontColor white
 ActorBorderColor #183840
 ActorFontColor #183840
 GroupBorderColor #139D90
 GroupBackgroundColor #EAF6F3
 GroupHeaderFontColor #183840
 NoteBackgroundColor #FFF1E7
 NoteBorderColor #F66B22
}
actor Student
participant Frontend as FE
participant "REST Controller" as API
participant ProfileService as S
database PostgreSQL as DB
title Read weekly availability | US-05
Student -> FE: Open weekly schedule
FE -> API: HTTPS GET /api/v1/availability/me\nAuthorization: Bearer <access_token>
ref over FE, DB
matching_00_authentication: valid JWT, ACTIVE account, STUDENT role
end ref

API -> S: getAvailability(verified sub)
S -> DB: SELECT schedule WHERE owner = sub
alt database read succeeds
 DB --> S: Weekly slots (possibly empty)
 S --> API: Availability
 API --> FE: 200 OK + {timeZone, items: [...]}
else storage failure
 DB --> S: Failure
 S --> API: INTERNAL_ERROR
 API --> FE: 500 + ErrorEnvelope
end
FE --> Student: Schedule, empty state or retry message
@enduml
