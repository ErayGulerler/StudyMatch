@startuml
hide footbox
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam ParticipantPadding 15
skinparam BoxPadding 8
skinparam sequence {
 ArrowColor #139D90
 LifeLineBorderColor #A5BFC2
 ParticipantBackgroundColor #183840
 ParticipantBorderColor #183840
 ParticipantFontColor white
 ActorBorderColor #183840
 ActorFontColor #183840
 GroupBorderColor #139D90
 GroupBackgroundColor #EAF6F3
 GroupHeaderFontColor #183840
 NoteBackgroundColor #FFF1E7
 NoteBorderColor #F66B22
}
actor Student
participant Frontend as FE
participant "REST Controller" as API
participant ProfileService as S
database PostgreSQL as DB
title Create a weekly slot | US-05
Student -> FE: Add weekly slot
FE -> API: HTTPS POST /api/v1/availability/me\nAuthorization: Bearer <access_token>\nSlotInput (JSON)
ref over FE, DB
matching_00_authentication: validate JWT, ACTIVE account, STUDENT role
end ref

API -> S: createSlot(verified sub, input)
S -> S: Validate weekday 1-7 and endTime > startTime
alt invalid field values
 S --> API: VALIDATION_ERROR; no write
 API --> FE: 422 + ErrorEnvelope
else valid slot
 S -> DB: INSERT slot with server UUID and owner=sub
 DB --> S: Slot
 S --> API: Slot
 API --> FE: 201 Created + Slot\nLocation: /api/v1/availability/me/{slotId}
end
FE --> Student: Updated availability or validation feedback
@enduml
