@startuml
hide footbox
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam ParticipantPadding 15
skinparam BoxPadding 8
skinparam sequence {
 ArrowColor #139D90
 LifeLineBorderColor #A5BFC2
 ParticipantBackgroundColor #183840
 ParticipantBorderColor #183840
 ParticipantFontColor white
 ActorBorderColor #183840
 ActorFontColor #183840
 GroupBorderColor #139D90
 GroupBackgroundColor #EAF6F3
 GroupHeaderFontColor #183840
 NoteBackgroundColor #FFF1E7
 NoteBorderColor #F66B22
}
actor Student
participant Frontend as FE
participant "REST Controller" as API
participant ProfileService as S
database PostgreSQL as DB
title Delete an owned weekly slot | US-05
Student -> FE: Delete slot
FE -> API: HTTPS DELETE /api/v1/availability/me/{slotId}\nAuthorization: Bearer <access_token>
ref over FE, DB
matching_00_authentication: validate JWT, ACTIVE account, STUDENT role
end ref

API -> S: deleteSlot(verified sub, slotId)
S -> DB: DELETE WHERE id=slotId AND owner=sub
DB --> S: Affected row count
alt one owned slot deleted
 S --> API: Deletion complete
 API --> FE: 204 No Content (no JSON body)
else absent or owned by someone else
 S --> API: NOT_FOUND
 API --> FE: 404 + ErrorEnvelope
end
FE --> Student: Refresh availability or show not-found message
@enduml
