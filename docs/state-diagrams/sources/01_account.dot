digraph G { 
graph [rankdir=TB,bgcolor="white",pad="0.4",nodesep="0.6",ranksep="0.85",fontname="Arial",fontsize=18,label="Account State Diagram",labelloc=t];
node [shape=box,style="rounded,filled",fillcolor="#EAF4F4",color="#168B85",fontname="Arial",fontsize=12,margin="0.25,0.16"];
edge [fontname="Arial",fontsize=10,color="#38404A",arrowsize=0.8];
start [shape=point,width=0.17,color=black,fillcolor=black,label=""];
active [label="ACTIVE"]; suspended [label="SUSPENDED"];
start -> active [label="IdentityService.registerStudent(data)\n[valid registration]"];
active -> suspended [label="ModerationService.changeStudentStatus(..., SUSPENDED, reason)\n/ Account.changeStatus(SUSPENDED)\n[authorized administrator]"];
suspended -> active [label="ModerationService.changeStudentStatus(..., ACTIVE, reason)\n/ Account.changeStatus(ACTIVE)\n[authorized administrator]"];
note [shape=note,style=filled,fillcolor="#FFF7E6",color="#C99A43",label="Rejected: unauthorized or invalid status change.\nSuspension invalidates login sessions and blocks protected actions.\nReactivation permits login with valid credentials.\nisActive() is a query, not a state transition.",fontsize=10];
suspended -> note [style=dotted,arrowhead=none,constraint=false];
}
