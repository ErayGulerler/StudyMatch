digraph G { 
graph [rankdir=TB,bgcolor="white",pad="0.4",nodesep="0.6",ranksep="0.85",fontname="Arial",fontsize=18,label="Study Group State Diagram",labelloc=t];
node [shape=box,style="rounded,filled",fillcolor="#EAF4F4",color="#168B85",fontname="Arial",fontsize=12,margin="0.25,0.16"];
edge [fontname="Arial",fontsize=10,color="#38404A",arrowsize=0.8];
start [shape=point,width=0.17,color=black,fillcolor=black,label=""];
active [label="ACTIVE"]; deleted [label="DELETED"];
start -> active [label="GroupSessionService.createGroup(token, data)\n[valid organiser and group data]"];
active -> active [label="GroupSessionService.transferOwnership(token, id, newOwner)\n/ StudyGroup.transferOwnership(memberId)\n[valid member and authorised organiser]"];
active -> deleted [label="GroupSessionService.deleteGroup(token, id)\n/ StudyGroup.markDeleted()\n[authorised organiser]"];
note [shape=note,style=filled,fillcolor="#FFF7E6",color="#C99A43",fontsize=10,label="On deletion: cancel future sessions of this group (US-11).\nRejected: member deletion, joining a deleted/full group.\nRejected actions preserve the current state.\nDELETED has no reactivation transition."];
deleted -> note [style=dotted,arrowhead=none,constraint=false];
}
