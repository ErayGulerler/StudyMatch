// StudyMatch UML class diagram. Edit this DOT file and render with Graphviz.
digraph StudyMatch {
graph [rankdir="TB", bgcolor="white", pad="0.35", nodesep="0.65", ranksep="0.85", splines="polyline", outputorder="edgesfirst", fontname="Arial", fontsize="16"];
node [shape="plain", fontname="Arial", fontsize="13"];
edge [fontname="Arial", fontsize="11", color="#38404A", fontcolor="#222222", penwidth="1.2", arrowsize="0.75", arrowhead="none", labeldistance="1.9"];
"Report" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#F3F4F6" ALIGN="CENTER"><FONT POINT-SIZE="11">&lt;&lt;entity&gt;&gt;</FONT><BR/><B>Report</B></TD></TR><TR><TD ALIGN="LEFT">- id: UUID<BR ALIGN="LEFT"/>- reporterId: UUID<BR ALIGN="LEFT"/>- reportedStudentId: UUID<BR ALIGN="LEFT"/>- reason: String<BR ALIGN="LEFT"/>- submittedAt: DateTime<BR ALIGN="LEFT"/>- status: ReportStatus<BR ALIGN="LEFT"/>- reviewedById: UUID [0..1]<BR ALIGN="LEFT"/>- outcome: String [0..1]<BR ALIGN="LEFT"/>- resolvedAt: DateTime [0..1]<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ resolve(adminId, outcome, now): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"AccountStatusChange" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#F3F4F6" ALIGN="CENTER"><FONT POINT-SIZE="11">&lt;&lt;audit record&gt;&gt;</FONT><BR/><B>AccountStatusChange</B></TD></TR><TR><TD ALIGN="LEFT">- id: UUID<BR ALIGN="LEFT"/>- studentId: UUID<BR ALIGN="LEFT"/>- administratorId: UUID<BR ALIGN="LEFT"/>- previousStatus: AccountStatus<BR ALIGN="LEFT"/>- newStatus: AccountStatus<BR ALIGN="LEFT"/>- reason: String<BR ALIGN="LEFT"/>- changedAt: DateTime<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"ModerationService" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#F3F4F6" ALIGN="CENTER"><FONT POINT-SIZE="11">&lt;&lt;service&gt;&gt;</FONT><BR/><B>ModerationService</B></TD></TR><TR><TD ALIGN="LEFT">+ submitReport(token, studentId, reason): Report<BR ALIGN="LEFT"/>+ listReports(token, status): Report[]<BR ALIGN="LEFT"/>+ resolveReport(token, id, outcome): void<BR ALIGN="LEFT"/>+ findStudent(token, idOrEmail): AccountSummary<BR ALIGN="LEFT"/>+ changeStudentStatus(token, id, status, reason): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"IdentityService" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#F3F4F6" ALIGN="CENTER"><FONT POINT-SIZE="11">&lt;&lt;service reference&gt;&gt;</FONT><BR/><B>IdentityService</B></TD></TR><TR><TD ALIGN="LEFT">+ validateSession(token): Principal<BR ALIGN="LEFT"/>+ lookUpAccount(idOrEmail): AccountSummary<BR ALIGN="LEFT"/>+ changeAccountStatus(id, status): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"ProfileService" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#F3F4F6" ALIGN="CENTER"><FONT POINT-SIZE="11">&lt;&lt;service reference&gt;&gt;</FONT><BR/><B>ProfileService</B></TD></TR><TR><TD ALIGN="LEFT">+ providePublicProfile(id): PublicProfile<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"ReportStatus" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#F3F4F6" ALIGN="CENTER"><FONT POINT-SIZE="11">&lt;&lt;enumeration&gt;&gt;</FONT><BR/><B>ReportStatus</B></TD></TR><TR><TD ALIGN="LEFT">PENDING<BR ALIGN="LEFT"/>RESOLVED<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"ModerationService" -> "Report" [label="creates / reviews / resolves", style="dashed", arrowhead="open"];
"ModerationService" -> "AccountStatusChange" [label="records each status change", style="dashed", arrowhead="open"];
"ModerationService" -> "IdentityService" [label="UC-05 / UC-06 / UC-07", style="dashed", arrowhead="open"];
"ModerationService" -> "ProfileService" [label="UC-13", style="dashed", arrowhead="open"];
"Report" -> "ReportStatus" [label="status", style="dashed", arrowhead="open"];
{rank=same; IdentityService; ModerationService; ProfileService;}
{rank=same; Report; AccountStatusChange;}
}
