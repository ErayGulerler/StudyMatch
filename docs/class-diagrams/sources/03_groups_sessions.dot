// StudyMatch UML class diagram. Edit this DOT file and render with Graphviz.
digraph StudyMatch {
graph [rankdir="TB", bgcolor="white", pad="0.35", nodesep="0.65", ranksep="0.85", splines="polyline", outputorder="edgesfirst", fontname="Arial", fontsize="16"];
node [shape="plain", fontname="Arial", fontsize="13"];
edge [fontname="Arial", fontsize="11", color="#38404A", fontcolor="#222222", penwidth="1.2", arrowsize="0.75", arrowhead="none", labeldistance="1.9"];
"StudyGroup" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#F3F4F6" ALIGN="CENTER"><FONT POINT-SIZE="11">&lt;&lt;entity&gt;&gt;</FONT><BR/><B>StudyGroup</B></TD></TR><TR><TD ALIGN="LEFT">- id: UUID<BR ALIGN="LEFT"/>- name: String<BR ALIGN="LEFT"/>- description: String [0..1]<BR ALIGN="LEFT"/>- subjectId: SubjectId<BR ALIGN="LEFT"/>- memberLimit: Integer<BR ALIGN="LEFT"/>- organiserId: UUID<BR ALIGN="LEFT"/>- status: GroupStatus<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ hasSpace(): Boolean<BR ALIGN="LEFT"/>+ isOrganiser(studentId): Boolean<BR ALIGN="LEFT"/>+ transferOwnership(memberId): void<BR ALIGN="LEFT"/>+ markDeleted(): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"Membership" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#F3F4F6" ALIGN="CENTER"><FONT POINT-SIZE="11">&lt;&lt;entity&gt;&gt;</FONT><BR/><B>Membership</B></TD></TR><TR><TD ALIGN="LEFT">- groupId: UUID<BR ALIGN="LEFT"/>- studentId: UUID<BR ALIGN="LEFT"/>- joinedAt: DateTime<BR ALIGN="LEFT"/>{unique(groupId, studentId)}<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"StudySession" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#F3F4F6" ALIGN="CENTER"><FONT POINT-SIZE="11">&lt;&lt;entity&gt;&gt;</FONT><BR/><B>StudySession</B></TD></TR><TR><TD ALIGN="LEFT">- id: UUID<BR ALIGN="LEFT"/>- groupId: UUID<BR ALIGN="LEFT"/>- title: String<BR ALIGN="LEFT"/>- startsAt: DateTime<BR ALIGN="LEFT"/>- endsAt: DateTime<BR ALIGN="LEFT"/>- locationOrLink: String<BR ALIGN="LEFT"/>- status: SessionStatus<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ edit(data, now): void<BR ALIGN="LEFT"/>+ cancel(now): void<BR ALIGN="LEFT"/>+ isUpcoming(now): Boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"GroupSessionService" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#F3F4F6" ALIGN="CENTER"><FONT POINT-SIZE="11">&lt;&lt;service&gt;&gt;</FONT><BR/><B>GroupSessionService</B></TD></TR><TR><TD ALIGN="LEFT">+ createGroup(token, data): StudyGroup<BR ALIGN="LEFT"/>+ searchGroups(token, subject): StudyGroup[]<BR ALIGN="LEFT"/>+ joinGroup(token, id) / leaveGroup(token, id)<BR ALIGN="LEFT"/>+ transferOwnership(token, id, newOwner)<BR ALIGN="LEFT"/>+ deleteGroup(token, id)<BR ALIGN="LEFT"/>+ scheduleSession(token, groupId, data)<BR ALIGN="LEFT"/>+ editSession(token, id, data)<BR ALIGN="LEFT"/>+ cancelSession(token, id)<BR ALIGN="LEFT"/>+ upcomingSessions(token): StudySession[]<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"StudentAccount" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#F3F4F6" ALIGN="CENTER"><FONT POINT-SIZE="11">&lt;&lt;reference&gt;&gt;</FONT><BR/><B>StudentAccount</B></TD></TR><TR><TD ALIGN="LEFT">+ id: UUID<BR ALIGN="LEFT"/>{Account with role = STUDENT}<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"GroupStatus" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#F3F4F6" ALIGN="CENTER"><FONT POINT-SIZE="11">&lt;&lt;enumeration&gt;&gt;</FONT><BR/><B>GroupStatus</B></TD></TR><TR><TD ALIGN="LEFT">ACTIVE<BR ALIGN="LEFT"/>DELETED<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"SessionStatus" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#F3F4F6" ALIGN="CENTER"><FONT POINT-SIZE="11">&lt;&lt;enumeration&gt;&gt;</FONT><BR/><B>SessionStatus</B></TD></TR><TR><TD ALIGN="LEFT">SCHEDULED<BR ALIGN="LEFT"/>CANCELLED<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"StudyGroup" -> "Membership" [label="members", taillabel="1", headlabel="0..*"];
"StudyGroup" -> "StudySession" [label="", xlabel="sessions", labelangle="-35", taillabel="1", headlabel="0..*"];
"StudentAccount" -> "Membership" [label="participates", taillabel="1", headlabel="0..*"];
"StudentAccount" -> "StudyGroup" [label="", xlabel="organises", labelangle="-35", taillabel="1", headlabel="0..*"];
"GroupSessionService" -> "StudyGroup" [label="manages", style="dashed", arrowhead="open"];
"GroupSessionService" -> "StudySession" [label="manages", style="dashed", arrowhead="open"];
"StudyGroup" -> "GroupStatus" [label="status", style="dashed", arrowhead="open"];
"StudySession" -> "SessionStatus" [label="status", style="dashed", arrowhead="open"];
{rank=same; StudentAccount; StudyGroup; StudySession;}
{rank=same; Membership; GroupStatus; SessionStatus;}
}
